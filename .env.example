# S4-10: mẫu biến môi trường. Sao chép thành file .env (cùng thư mục) rồi điền giá trị thật.
# KHÔNG đưa file .env lên GitHub (đã có trong .gitignore).

# Cổng mở hệ thống trên máy chạy staging, mở bằng http://<IP máy>:<APP_PORT>
APP_PORT=8088
# Địa chỉ mọi người dùng để mở hệ thống (dùng trong link email và được phép gọi API), ví dụ http://192.168.1.15:8088
PUBLIC_URL=http://localhost:8088

# Cơ sở dữ liệu
DB_NAME=homestay_db
DB_USERNAME=homestay_app
# Bắt buộc. Tự đặt mật khẩu mạnh, không dùng lại mật khẩu đã từng nằm trong kho mã.
DB_PASSWORD=

# Khoá ký JWT. Bắt buộc, mỗi khoá là chuỗi ngẫu nhiên tối thiểu 64 ký tự (tạo bằng: openssl rand -base64 48).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Đặt true khi chạy HTTPS.
JWT_REFRESH_COOKIE_SECURE=false

# Email (S4-04, S4-05, quên mật khẩu): mặc định staging gửi mọi thư vào Mailpit (hộp thư giả),
# xem ở http://localhost:8025 trên máy chạy staging.
# Muốn gửi thư thật qua Gmail: bỏ dấu # ở 6 dòng dưới, điền Gmail và MẬT KHẨU ỨNG DỤNG (không phải mật khẩu đăng nhập).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=true
# MAIL_STARTTLS=true
MAIL_FROM=HomeStay <no-reply@homestay.local>
# Cổng trang xem thư Mailpit
MAIL_UI_PORT=8025
# 127.0.0.1 = chỉ máy chạy staging xem được; 0.0.0.0 = máy khác cùng mạng cũng xem được (http://<IP>:8025)
MAIL_UI_BIND=127.0.0.1

# Sao lưu cơ sở dữ liệu (S4-10 Lát 3)
# Lịch theo cú pháp cron, giờ Asia/Ho_Chi_Minh. Mặc định 2:00 hằng ngày.
BACKUP_SCHEDULE=0 2 * * *
# Số bản sao lưu giữ lại
BACKUP_KEEP=7
# Thư mục lưu bản sao lưu trên máy chạy staging (đã có trong .gitignore)
BACKUP_DIR=./backups